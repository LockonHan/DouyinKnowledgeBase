<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DouyinKnowledgeBase"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <!-- 右上角设置入口 -->
        <Button
            x:Name="SettingsButton"
            Click="SettingsButton_Click"
            ToolTipService.ToolTip="设置"
            AutomationProperties.Name="设置"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Padding="10"
            Background="Transparent">
            <FontIcon Glyph="&#xE713;" FontSize="18" />
        </Button>

        <!-- 占位内容：后续放视频列表 -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            MaxWidth="600">
            <TextBlock
                Text="抖音知识库"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="把喜欢的知识类视频保存到本地，转写、总结，沉淀为你的知识库。"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Opacity="0.7" />
            <Button
                x:Name="DownloadButton"
                Click="DownloadButton_Click"
                Content="粘贴链接，下载并转写"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Padding="24,10"
                Margin="0,12,0,0" />
            <Button
                x:Name="SummaryButton"
                Click="SummaryButton_Click"
                Content="我已有转写稿，直接 AI 总结"
                HorizontalAlignment="Center"
                Padding="16,8" />
            <Button
                x:Name="SetupButton"
                Click="SetupButton_Click"
                Content="环境准备（下载模型与运行时）"
                HorizontalAlignment="Center"
                Padding="16,8" />
        </StackPanel>
    </Grid>
</Page>