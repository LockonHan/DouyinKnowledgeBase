<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Padding="32,24,32,32" Spacing="8">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回"
                    AutomationProperties.Name="返回"
                    Padding="8"
                    Background="Transparent">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="文稿总结" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Text="选择本地转写稿，调用配置好的大模型生成结构化知识科普文章（Markdown）。"
                TextWrapping="Wrap"
                Opacity="0.7" />

            <!-- 选择转写稿 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PickFileButton"
                    Grid.Column="0"
                    Click="PickFileButton_Click"
                    Content="选择转写稿（.txt）"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="FileNameText"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Text="尚未选择文件"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Opacity="0.7" />
            </Grid>

            <ProgressBar
                x:Name="GenerateProgress"
                IsIndeterminate="True"
                Margin="0,8,0,0"
                Visibility="Collapsed" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button
                    x:Name="GenerateButton"
                    Click="GenerateButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="生成知识文章" />
                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Content="保存为 Markdown"
                    IsEnabled="False" />
            </StackPanel>

            <!-- 生成结果 -->
            <TextBox
                x:Name="ResultBox"
                Margin="0,8,0,0"
                MinHeight="420"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                FontFamily="Consolas, XHei Ui"
                PlaceholderText="生成的文章将显示在这里，可直接编辑后保存。"
                AutomationProperties.Name="生成结果" />

            <InfoBar
                x:Name="StatusInfo"
                IsOpen="False"
                IsClosable="True"
                Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>