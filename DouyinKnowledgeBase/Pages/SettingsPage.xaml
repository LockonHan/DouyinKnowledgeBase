<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Padding="32,24,32,32" Spacing="8">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回"
                    AutomationProperties.Name="返回"
                    Padding="8"
                    Background="Transparent">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Text="大模型接入点（OpenAI 兼容）"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,8,0,4" />

            <TextBlock Text="用于把转写文稿总结成结构化知识文章。配置仅保存在本机应用数据目录。"
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Spacing="4" Margin="0,12,0,0">
                <TextBlock Text="接入点地址" />
                <TextBox
                    x:Name="BaseUrlBox"
                    PlaceholderText="https://api.openai.com/v1"
                    AutomationProperties.Name="接入点地址" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="API Key" />
                <PasswordBox
                    x:Name="ApiKeyBox"
                    PasswordRevealMode="Peek"
                    PlaceholderText="sk-..."
                    AutomationProperties.Name="API Key" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="模型名称" />
                <TextBox
                    x:Name="ModelBox"
                    PlaceholderText="deepseek-chat / qwen-plus / gpt-4o-mini"
                    AutomationProperties.Name="模型名称" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="温度" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider
                        x:Name="TemperatureSlider"
                        Minimum="0"
                        Maximum="2"
                        StepFrequency="0.1"
                        Width="260"
                        ValueChanged="TemperatureSlider_ValueChanged"
                        AutomationProperties.Name="温度" />
                    <TextBlock x:Name="TemperatureText" Text="0.7" VerticalAlignment="Center" MinWidth="32" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="保存配置" />
                <Button
                    x:Name="TestButton"
                    Click="TestButton_Click"
                    Content="测试连接" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfo"
                IsOpen="False"
                IsClosable="True"
                Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>