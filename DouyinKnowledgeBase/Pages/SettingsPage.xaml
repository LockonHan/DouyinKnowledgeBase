<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Padding="32,24,32,32" Spacing="8">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回"
                    AutomationProperties.Name="返回"
                    Padding="8"
                    Background="Transparent">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 大模型接入点 -->
            <TextBlock
                Text="大模型接入点（OpenAI 兼容）"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,8,0,4" />

            <TextBlock Text="用于把转写文稿总结成结构化知识文章。配置仅保存在本机应用数据目录。"
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Spacing="4" Margin="0,12,0,0">
                <TextBlock Text="接入点地址" />
                <TextBox
                    x:Name="BaseUrlBox"
                    PlaceholderText="https://api.openai.com/v1"
                    AutomationProperties.Name="接入点地址" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="API Key" />
                <PasswordBox
                    x:Name="ApiKeyBox"
                    PasswordRevealMode="Peek"
                    PlaceholderText="sk-..."
                    AutomationProperties.Name="API Key" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="模型名称" />
                <TextBox
                    x:Name="ModelBox"
                    PlaceholderText="deepseek-chat / qwen-plus / gpt-4o-mini"
                    AutomationProperties.Name="模型名称" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="温度" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Slider
                        x:Name="TemperatureSlider"
                        Minimum="0"
                        Maximum="2"
                        StepFrequency="0.1"
                        Width="260"
                        ValueChanged="TemperatureSlider_ValueChanged"
                        AutomationProperties.Name="温度" />
                    <TextBlock x:Name="TemperatureText" Text="0.7" VerticalAlignment="Center" MinWidth="32" />
                </StackPanel>
            </StackPanel>

            <!-- 视频下载与转写 -->
            <TextBlock
                Text="视频下载与转写"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,24,0,4" />

            <TextBlock Text="粘贴抖音链接后，应用会调用本机 Python 执行下载、音频提取与本地 FunASR 转写。"
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Spacing="4" Margin="0,12,0,0">
                <TextBlock Text="Python 解释器路径（需已安装 funasr）" />
                <TextBox
                    x:Name="PythonPathBox"
                    PlaceholderText="C:\Users\你\anaconda3\python.exe"
                    AutomationProperties.Name="Python 解释器路径" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="数据目录（存放 videos / audio / transcripts / cookies.txt）" />
                <TextBox
                    x:Name="DataDirBox"
                    PlaceholderText="D:\project\Codex\抖音知识库\data"
                    AutomationProperties.Name="数据目录" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="转写设备" />
                <ComboBox
                    x:Name="DeviceBox"
                    MinWidth="200"
                    AutomationProperties.Name="转写设备">
                    <ComboBoxItem Content="auto" />
                    <ComboBoxItem Content="cuda:0" />
                    <ComboBoxItem Content="cpu" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="离线模型目录（可选；留空使用默认位置）" />
                <TextBox
                    x:Name="ModelsDirBox"
                    PlaceholderText="D:\DouyinKnowledgeBase\runtime\models"
                    AutomationProperties.Name="离线模型目录" />
            </StackPanel>

            <ToggleSwitch
                x:Name="ResidentSwitch"
                Header="常驻转写加速"
                OnContent="已开启"
                OffContent="已关闭"
                Margin="0,4,0,0"
                AutomationProperties.Name="常驻转写加速" />

            <TextBlock
                Text="开启后转写模型常驻内存，后续转写无需重新加载（首次加载约 20-30 秒，常驻占用约 2 GB 内存 / 显存）。"
                TextWrapping="Wrap"
                Opacity="0.55"
                FontSize="12" />

            <TextBlock
                Text="提示：抖音下载依赖浏览器 Cookie。若下载失败，可在下载页点“获取 / 刷新 Cookie”登录一次。"
                TextWrapping="Wrap"
                Opacity="0.55"
                FontSize="12"
                Margin="0,4,0,0" />

            <Button
                x:Name="SetupButton"
                Click="SetupButton_Click"
                Content="打开环境准备（下载运行时与模型）"
                Margin="0,12,0,0"
                AutomationProperties.Name="打开环境准备" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="保存配置" />
                <Button
                    x:Name="TestButton"
                    Click="TestButton_Click"
                    Content="测试连接" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfo"
                IsOpen="False"
                IsClosable="True"
                Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>