<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.CookiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource DouKBPaperBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DouKBHairlineStyle}" />

        <Grid Grid.Row="1" Padding="46,36,46,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="10">
                <TextBlock Text="获取抖音 Cookie" Style="{StaticResource DouKBDisplayTextStyle}" />
                <TextBlock
                    Style="{StaticResource DouKBLedgerTextStyle}"
                    Text="应用会打开抖音网页，由页面自动写入 ttwid、msToken 等下载所需 Cookie。若下载仍失败，可在此登录账号后重试。" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,22,0,18"
                Orientation="Horizontal"
                Spacing="22">
                <Button
                    x:Name="ExtractButton"
                    Click="ExtractButton_Click"
                    Content="提取 Cookie 并保存"
                    Style="{StaticResource DouKBStrongButtonStyle}" />
                <Button
                    x:Name="ReloadButton"
                    Click="ReloadButton_Click"
                    Content="重新打开抖音"
                    Style="{StaticResource DouKBQuietButtonStyle}" />
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Content="返回快速获取"
                    Style="{StaticResource DouKBQuietButtonStyle}" />
            </StackPanel>

            <Border
                Grid.Row="2"
                BorderBrush="{ThemeResource DouKBRuleBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <WebView2 x:Name="Web" />
            </Border>

            <TextBlock
                Grid.Row="3"
                x:Name="StatusText"
                Margin="0,12,0,0"
                Style="{StaticResource DouKBCaptionTextStyle}"
                Text="正在加载…" />
        </Grid>
    </Grid>
</Page>
