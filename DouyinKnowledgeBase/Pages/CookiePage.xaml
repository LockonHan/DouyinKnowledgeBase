<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.CookiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Button
                x:Name="BackButton"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回"
                AutomationProperties.Name="返回"
                Padding="8"
                Background="Transparent">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Text="获取抖音 Cookie" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="应用会打开抖音网页，由页面自动写入 ttwid、msToken 等下载所需 Cookie。若下载仍失败，可在此登录账号后重试。"
            TextWrapping="Wrap"
            Opacity="0.75" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,12,0,12">
            <Button
                x:Name="ReloadButton"
                Click="ReloadButton_Click"
                Content="重新打开抖音" />
            <Button
                x:Name="ExtractButton"
                Click="ExtractButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                Content="提取 Cookie 并保存" />
        </StackPanel>

        <Border
            Grid.Row="3"
            BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <WebView2 x:Name="Web" />
        </Border>

        <TextBlock
            Grid.Row="4"
            x:Name="StatusText"
            Margin="0,10,0,0"
            TextWrapping="Wrap"
            Opacity="0.85"
            Text="正在加载…" />
    </Grid>
</Page>