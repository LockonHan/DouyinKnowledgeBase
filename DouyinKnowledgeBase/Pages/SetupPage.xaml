<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource DouKBPaperBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DouKBHairlineStyle}" />

        <ScrollViewer
            Grid.Row="1"
            Padding="46,36,46,40"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="0">

                <TextBlock Text="环境准备" Style="{StaticResource DouKBDisplayTextStyle}" />
                <TextBlock
                    Margin="0,10,0,0"
                    Style="{StaticResource DouKBLedgerTextStyle}"
                    Text="首次使用前，准备本地转写与下载所需的运行环境。整个过程可重复执行，已就绪的项目会自动跳过。" />

                <!-- ==================== 转写设备 ==================== -->
                <TextBlock
                    Margin="0,34,0,0"
                    Style="{StaticResource DouKBSectionTitleStyle}"
                    Text="转写设备" />
                <TextBlock
                    x:Name="GpuText"
                    Margin="0,8,0,0"
                    Style="{StaticResource DouKBCaptionTextStyle}"
                    Text="" />
                <Border Margin="0,14,0,0" Style="{StaticResource DouKBHairlineStyle}" />
                <RadioButtons
                    x:Name="DeviceChoice"
                    Margin="0,14,0,0"
                    AutomationProperties.Name="转写设备"
                    SelectionChanged="DeviceChoice_SelectionChanged">
                    <RadioButton x:Name="GpuOption" Content="GPU 加速：安装 CUDA 版 PyTorch（约 2.5 GB），转写更快" />
                    <RadioButton x:Name="CpuOption" Content="仅 CPU：安装 CPU 版 PyTorch（约 200 MB），兼容性最好" />
                </RadioButtons>

                <!-- ==================== 运行环境位置 ==================== -->
                <TextBlock
                    Margin="0,34,0,0"
                    Style="{StaticResource DouKBSectionTitleStyle}"
                    Text="运行环境位置" />
                <Border Margin="0,14,0,0" Style="{StaticResource DouKBHairlineStyle}" />

                <StackPanel Margin="0,16,0,0" Spacing="6">
                    <TextBlock Style="{StaticResource DouKBLedgerTextStyle}" Text="模型缓存目录（ModelScope 缓存根，模型位于其下 models\iic\）" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ModelsDirBox"
                            Grid.Column="0"
                            AutomationProperties.Name="模型缓存目录"
                            Style="{StaticResource DouKBLineTextBoxStyle}" />
                        <Button
                            x:Name="BrowseButton"
                            Grid.Column="1"
                            Click="BrowseButton_Click"
                            AutomationProperties.Name="浏览模型目录"
                            Content="浏览…"
                            Style="{StaticResource DouKBQuietButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource DouKBCaptionTextStyle}"
                        Text="也可以指定已有的离线模型目录；若其中已包含所需模型，安装时会直接复用。" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Spacing="5">
                    <TextBlock x:Name="PythonText" Style="{StaticResource DouKBCaptionTextStyle}" Text="" />
                    <TextBlock x:Name="BrowsersText" Style="{StaticResource DouKBCaptionTextStyle}" Text="" />
                    <TextBlock x:Name="FfmpegText" Style="{StaticResource DouKBCaptionTextStyle}" Text="" />
                </StackPanel>

                <!-- ==================== 操作 ==================== -->
                <StackPanel Margin="0,28,0,0" Orientation="Horizontal" Spacing="22">
                    <Button
                        x:Name="StartButton"
                        Click="StartButton_Click"
                        AutomationProperties.Name="开始准备环境"
                        Content="开始准备环境"
                        Style="{StaticResource DouKBStrongButtonStyle}" />
                    <Button
                        x:Name="StopButton"
                        Click="StopButton_Click"
                        AutomationProperties.Name="停止准备环境"
                        Content="停止准备"
                        IsEnabled="False"
                        Style="{StaticResource DouKBQuietButtonStyle}" />
                    <Button
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        AutomationProperties.Name="重新自检"
                        Content="重新自检"
                        Style="{StaticResource DouKBQuietButtonStyle}" />
                </StackPanel>

                <ProgressBar
                    x:Name="SetupProgressBar"
                    Margin="0,18,0,0"
                    Background="{ThemeResource DouKBRuleBrush}"
                    CornerRadius="0"
                    Foreground="{ThemeResource DouKBLiveBrush}"
                    Maximum="100"
                    Minimum="0"
                    Value="0" />
                <TextBlock
                    x:Name="TransferText"
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource DouKBLiveBrush}"
                    FontWeight="SemiBold"
                    Style="{StaticResource DouKBLedgerTextStyle}"
                    Text=""
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StepText"
                    Margin="0,4,0,0"
                    Style="{StaticResource DouKBLedgerTextStyle}"
                    Text=""
                    TextWrapping="Wrap" />

                <InfoBar
                    x:Name="StatusInfo"
                    Margin="0,10,0,0"
                    IsClosable="True"
                    IsOpen="False" />

                <!-- ==================== 自检结果 ==================== -->
                <TextBlock
                    Margin="0,34,0,0"
                    Style="{StaticResource DouKBSectionTitleStyle}"
                    Text="自检结果" />
                <Border Margin="0,14,0,0" Style="{StaticResource DouKBHairlineStyle}" />
                <ItemsControl Margin="0,14,0,0" x:Name="CheckList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,1,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="15"
                                    Text="{Binding Icon}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DouKBLedgerTextStyle}"
                                        Foreground="{ThemeResource DouKBInkBrush}"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource DouKBCaptionTextStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ==================== 安装日志 ==================== -->
                <TextBlock
                    Margin="0,34,0,0"
                    Style="{StaticResource DouKBSectionTitleStyle}"
                    Text="安装日志" />
                <Border Margin="0,14,0,0" Style="{StaticResource DouKBHairlineStyle}" />
                <TextBox
                    x:Name="LogBox"
                    Margin="0,14,0,0"
                    Height="200"
                    AcceptsReturn="True"
                    AutomationProperties.Name="安装日志"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
