<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Padding="32,24,32,32" Spacing="8">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回"
                    AutomationProperties.Name="返回"
                    Padding="8"
                    Background="Transparent">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="环境准备" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Text="首次使用前，需要准备本地转写与下载所需的运行环境：PyTorch、FunASR 依赖、Playwright 浏览器与语音模型。整个过程可重复执行，已就绪的项目会自动跳过。"
                TextWrapping="Wrap"
                Opacity="0.7" />

            <!-- 设备选择 -->
            <TextBlock Text="转写设备" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <TextBlock x:Name="GpuText" TextWrapping="Wrap" Opacity="0.8" />
            <RadioButtons
                x:Name="DeviceChoice"
                SelectionChanged="DeviceChoice_SelectionChanged"
                Margin="0,8,0,0"
                AutomationProperties.Name="转写设备">
                <RadioButton x:Name="GpuOption" Content="GPU 加速：安装 CUDA 版 PyTorch（约 2.5 GB），转写更快" />
                <RadioButton x:Name="CpuOption" Content="仅 CPU：安装 CPU 版 PyTorch（约 200 MB），兼容性最好" />
            </RadioButtons>

            <!-- 目录 -->
            <TextBlock Text="运行环境位置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />

            <StackPanel Spacing="4">
                <TextBlock Text="模型缓存目录（ModelScope 缓存根，模型位于其下 models\iic\）" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ModelsDirBox"
                        Grid.Column="0"
                        AutomationProperties.Name="模型缓存目录" />
                    <Button
                        x:Name="BrowseButton"
                        Grid.Column="1"
                        Click="BrowseButton_Click"
                        Content="浏览…"
                        AutomationProperties.Name="浏览模型目录" />
                </Grid>
                <TextBlock
                    Text="也可以指定已有的离线模型目录；若其中已包含所需模型，安装时会直接复用。"
                    TextWrapping="Wrap"
                    Opacity="0.55"
                    FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="2" Margin="0,10,0,0">
                <TextBlock x:Name="PythonText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                <TextBlock x:Name="BrowsersText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                <TextBlock x:Name="FfmpegText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                <Button
                    x:Name="StartButton"
                    Click="StartButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="开始准备环境"
                    AutomationProperties.Name="开始准备环境" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="重新自检"
                    AutomationProperties.Name="重新自检" />
            </StackPanel>

            <ProgressBar x:Name="SetupProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0" />
            <TextBlock x:Name="StepText" TextWrapping="Wrap" Opacity="0.85" />

            <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" Margin="0,8,0,0" />

            <!-- 自检结果 -->
            <TextBlock Text="自检结果" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <ItemsControl x:Name="CheckList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Icon}"
                                FontSize="15"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 日志 -->
            <TextBlock Text="安装日志" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,4" />
            <TextBox
                x:Name="LogBox"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                Height="200"
                FontFamily="Consolas"
                FontSize="12"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                AutomationProperties.Name="安装日志" />
        </StackPanel>
    </ScrollViewer>
</Page>