<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DouyinKnowledgeBase.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Padding="32,24,32,32" Spacing="8">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回"
                    AutomationProperties.Name="返回"
                    Padding="8"
                    Background="Transparent">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="下载并转写" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Text="粘贴抖音分享文案或链接，应用会自动下载视频、提取音频，并调用本地 FunASR 模型转写成文字稿。"
                TextWrapping="Wrap"
                Opacity="0.7" />

            <TextBlock
                x:Name="CookieHintText"
                Text="提示：抖音下载需要浏览器 Cookie。若下载失败，请以管理员身份运行 tools\export_cookies.py 重新导出。"
                TextWrapping="Wrap"
                Opacity="0.55"
                FontSize="12"
                Margin="0,4,0,0" />

            <TextBox
                x:Name="ShareBox"
                Margin="0,8,0,0"
                Height="96"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                PlaceholderText="在此粘贴抖音分享文案或链接，例如：https://v.douyin.com/xxxxxxx/"
                AutomationProperties.Name="分享链接" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button
                    x:Name="StartButton"
                    Click="StartButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="开始下载并转写" />
                <Button
                    x:Name="ClearButton"
                    Click="ClearButton_Click"
                    Content="清空" />
            </StackPanel>

            <ProgressBar
                x:Name="Progress"
                Margin="0,10,0,0"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="StatusText"
                Margin="0,4,0,0"
                TextWrapping="Wrap"
                Opacity="0.85" />

            <!-- 结果 -->
            <TextBlock
                x:Name="ResultTitleText"
                Margin="0,12,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Visibility="Collapsed" />

            <TextBox
                x:Name="TranscriptBox"
                Margin="0,4,0,0"
                MinHeight="300"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed"
                AutomationProperties.Name="转写结果" />

            <StackPanel
                x:Name="ResultActions"
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,8,0,0"
                Visibility="Collapsed">
                <Button
                    x:Name="SummarizeButton"
                    Click="SummarizeButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="用这篇稿去 AI 总结" />
                <Button
                    x:Name="OpenFolderButton"
                    Click="OpenFolderButton_Click"
                    Content="打开转写稿所在文件夹" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>